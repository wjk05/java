# =============================================================================
# Ruici AI Platform - Kubernetes 部署配置
# 复制为 deploy.env 后按需修改：cp deploy.env.example deploy.env
# 注意：deploy.env 含密钥，不要提交到版本库（已在 .gitignore 中忽略）
# =============================================================================

# ------------------------- 命名空间与副本 -------------------------
NAMESPACE=ruici-ai
APP_REPLICAS=1
FRONTEND_REPLICAS=2

# ------------------------- 镜像 -------------------------
# 留空：镜像只构建在本机，脚本会自动导入本机 containerd（适合单节点 / 本机即节点）
# 填写示例：harbor.example.com/ruici 或 192.168.233.129:30002/library
IMAGE_PREFIX=
BACKEND_IMAGE_NAME=ruici-ai-backend
FRONTEND_IMAGE_NAME=ruici-ai-frontend
IMAGE_TAG=latest

# 构建工具：docker / nerdctl / podman
CONTAINER_CLI=docker

# 是否预拉取基础设施镜像（pgvector/redis/minio/mc）并导入本机 containerd
# 集群节点无法直连 Docker Hub 时保持 1
PRELOAD_INFRA=1

# ------------------------- 访问方式 -------------------------
# NodePort | ClusterIP | LoadBalancer
FRONTEND_SERVICE_TYPE=NodePort
# 留空则使用集群自动分配的端口（30000-32767）
FRONTEND_NODE_PORT=30080

# 可选：启用 Ingress（填写域名后生效，留空则不创建）
INGRESS_HOST=
INGRESS_CLASS=nginx
# 已存在的 TLS Secret 名称（如 cert-manager 签发），留空则使用 HTTP
INGRESS_TLS_SECRET=

# ------------------------- 存储 -------------------------
# 留空使用集群默认 StorageClass；没有默认 StorageClass 时必须填写
STORAGE_CLASS=
POSTGRES_SIZE=10Gi
REDIS_SIZE=2Gi
MINIO_SIZE=20Gi

# ------------------------- 数据库 -------------------------
POSTGRES_USER=postgres
POSTGRES_DB=ruici_ai_platform
# 留空则脚本自动生成，并写回 deploy.env（首次部署后请勿再改，否则连不上已有数据卷）
POSTGRES_PASSWORD=

# ------------------------- 对象存储（MinIO） -------------------------
APP_STORAGE_BUCKET=ruici-ai-platform
APP_STORAGE_REGION=us-east-1
# 同时作为 MinIO 的 root 账号密码，留空则自动生成并写回 deploy.env
APP_STORAGE_ACCESS_KEY=minioadmin
APP_STORAGE_SECRET_KEY=

# ------------------------- AI Provider -------------------------
AI_DEFAULT_PROVIDER=third-party
THIRD_PARTY_BASE_URL=https://api-s.zwenooo.link/v1
THIRD_PARTY_API_KEY=
THIRD_PARTY_MODEL=gpt5.2
THIRD_PARTY_FALLBACK_MODEL=qwen-plus
# DashScope / Qwen：向量化 + 语音必需
AI_BAILIAN_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-v3
APP_VOICE_INTERVIEW_LLM_PROVIDER=dashscope

# 可选：OpenAI 原生 Provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# ------------------------- 其他 -------------------------
# 经同一域名访问时用 * 即可；若前后端分离部署可填具体来源，逗号分隔
CORS_ALLOWED_ORIGINS=*
# 单轮语音交互参数（一般无需修改）
APP_VOICE_USER_UTTERANCE_DEBOUNCE_MS=2500
APP_VOICE_ASR_SILENCE_MS=2000
APP_INTERVIEW_FOLLOW_UP_COUNT=1
APP_INTERVIEW_EVALUATION_BATCH_SIZE=8